      {id:"ENG-SOCIAL-005",area:"Engagement/Social/Highlights",summary:"Admin-Promo/Announcements verlieren Actor-Attribution, Rust immer admin.",risk:"Audit-Log ungenau.",test:"Discord-ID saved."}
    ];

    const CHECKS = [
      ["checked", "geprueft"],
      ["approval", "Freigabe benoetigt"],
      ["testPlanned", "Test geplant"],
      ["done", "erledigt"]
    ];

    const $ = (id) => document.getElementById(id);
    const norm = (finding) => ({
      ...finding,
      cat: finding.cat || DEFAULT_CATEGORY,
      status: finding.status || DEFAULT_STATUS,
      assessment: finding.assessment || DEFAULT_ASSESSMENT
    });
    const DATA = FINDINGS.map(norm);

    function escapeHtml(value) {
      return String(value)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }

    function key(id, field) {
      return `python-rust-parity-audit:v1:${id}:${field}`;
    }

    function isChecked(id, field) {
      return localStorage.getItem(key(id, field)) === "1";
    }

    function setChecked(id, field, checked) {
      localStorage.setItem(key(id, field), checked ? "1" : "0");
    }

    function getNote(id) {
      return localStorage.getItem(key(id, "note")) || "";
    }

    function setNote(id, value) {
      localStorage.setItem(key(id, "note"), value);
    }

    function uniqueValues(field) {
      return [...new Set(DATA.map((item) => item[field]))].sort((a, b) => a.localeCompare(b));
    }

    function populateSelect(id, values) {
      const select = $(id);
      for (const value of values) {
        const option = document.createElement("option");
        option.value = value;
        option.textContent = value;
        select.appendChild(option);
      }
    }

    function renderModules() {
      $("moduleRows").innerHTML = Object.entries(AREA_META).map(([area, meta]) => `
        <tr>
          <td>${escapeHtml(area)}</td>
          <td>${escapeHtml(meta.py)}</td>
          <td>${escapeHtml(meta.rust)}</td>
          <td>${escapeHtml(meta.focus)}</td>
        </tr>
      `).join("");
    }

    function currentFilters() {
      return {
        area: $("areaFilter").value,
        status: $("statusFilter").value,
        cat: $("categoryFilter").value,
        search: $("searchFilter").value.trim().toLowerCase()
      };
    }

    function matches(finding, filters) {
      if (filters.area && finding.area !== filters.area) return false;
      if (filters.status && finding.status !== filters.status) return false;
      if (filters.cat && finding.cat !== filters.cat) return false;
      if (!filters.search) return true;
      const meta = AREA_META[finding.area] || {};
      const haystack = [
        finding.id, finding.area, finding.summary, finding.risk, finding.test,
        finding.cat, finding.status, finding.assessment, meta.py, meta.rust, meta.focus
      ].join(" ").toLowerCase();
      return haystack.includes(filters.search);
    }

    function renderFinding(finding) {
      const meta = AREA_META[finding.area] || {py:"bot*/scripts/ops", rust:"rust/"};
      const statusClass = `status-${finding.status.replace(/[^a-z0-9]+/gi, "-").toLowerCase()}`;
      const checkboxHtml = CHECKS.map(([field, label]) => `
        <label class="checkbox">
          <input type="checkbox" data-id="${escapeHtml(finding.id)}" data-field="${field}" ${isChecked(finding.id, field) ? "checked" : ""}>
          <span>${escapeHtml(label)}</span>
        </label>
      `).join("");
      return `
        <article class="finding" data-id="${escapeHtml(finding.id)}">
          <div class="finding-head">
            <h3 class="finding-title">${escapeHtml(finding.id)}: ${escapeHtml(finding.summary)}</h3>
            <div class="badges">
              <span class="badge">${escapeHtml(finding.area)}</span>
              <span class="badge ${statusClass}">${escapeHtml(finding.status)}</span>
              <span class="badge">${escapeHtml(finding.cat)}</span>
            </div>
          </div>
          <div class="finding-body">
            <dl class="fields">
              <div class="field"><dt>ID</dt><dd>${escapeHtml(finding.id)}</dd></div>
              <div class="field"><dt>Bereich</dt><dd>${escapeHtml(finding.area)}</dd></div>
              <div class="field"><dt>Kurzbeschreibung</dt><dd>${escapeHtml(finding.summary)}</dd></div>
              <div class="field"><dt>Risiko</dt><dd>${escapeHtml(finding.risk)}</dd></div>
              <div class="field"><dt>Python-Quelle</dt><dd>${escapeHtml(meta.py)}</dd></div>
              <div class="field"><dt>Rust-Ziel</dt><dd>${escapeHtml(meta.rust)}</dd></div>
              <div class="field"><dt>Git/Doku-Bewertung</dt><dd>${escapeHtml(finding.assessment)}</dd></div>
              <div class="field"><dt>Testidee</dt><dd>${escapeHtml(finding.test)}</dd></div>
              <div class="field"><dt>Kategorie</dt><dd>${escapeHtml(finding.cat)}</dd></div>
              <div class="field"><dt>Status</dt><dd>${escapeHtml(finding.status)}</dd></div>
            </dl>
            <div class="tracking">
              ${checkboxHtml}
              <label class="filter-label">Notizfeld
                <textarea data-id="${escapeHtml(finding.id)}" placeholder="Lokale Notiz...">${escapeHtml(getNote(finding.id))}</textarea>
              </label>
            </div>
          </div>
        </article>
      `;
    }

    function visibleData() {
      const filters = currentFilters();
      return DATA.filter((finding) => matches(finding, filters));
    }

    function renderFindings() {
      const filters = currentFilters();
      const visible = DATA.filter((finding) => matches(finding, filters));
      $("findingsList").innerHTML = visible.map(renderFinding).join("") || "<p>Keine Findings fuer diesen Filter.</p>";
      const active = [
        filters.area && `Bereich: ${filters.area}`,
        filters.status && `Status: ${filters.status}`,
        filters.cat && `Kategorie: ${filters.cat}`,
        filters.search && `Suche: ${filters.search}`
      ].filter(Boolean);
      $("filterInfo").textContent = active.length ? `Aktive Filter: ${active.join(" | ")}` : "Keine Filter aktiv.";
      updateSummary();
    }

    function renderOpenQuestions() {
      const questions = DATA.filter((finding) => finding.status === "unklar" || finding.cat.includes("offene Frage"));
      $("openQuestions").innerHTML = questions.map((finding) => `
        <li><strong>${escapeHtml(finding.id)}</strong> (${escapeHtml(finding.area)}): ${escapeHtml(finding.summary)}</li>
      `).join("");
    }

    function updateSummary() {
      const visible = visibleData();
      let checkedCount = 0;
      for (const finding of DATA) {
        for (const [field] of CHECKS) {
          if (isChecked(finding.id, field)) checkedCount += 1;
        }
      }
      $("totalFindings").textContent = DATA.length;
      $("visibleFindings").textContent = visible.length;
      $("doneFindings").textContent = DATA.filter((finding) => isChecked(finding.id, "done")).length;
      $("checkedBoxes").textContent = `${checkedCount} / ${DATA.length * CHECKS.length}`;
    }

    function init() {
      renderModules();
      populateSelect("areaFilter", uniqueValues("area"));
      populateSelect("statusFilter", uniqueValues("status"));
      populateSelect("categoryFilter", uniqueValues("cat"));
      renderOpenQuestions();
      renderFindings();

      for (const id of ["areaFilter", "statusFilter", "categoryFilter", "searchFilter"]) {
        $(id).addEventListener("input", renderFindings);
        $(id).addEventListener("change", renderFindings);
      }
      $("resetFilters").addEventListener("click", () => {
        $("areaFilter").value = "";
        $("statusFilter").value = "";
        $("categoryFilter").value = "";
        $("searchFilter").value = "";
        renderFindings();
      });

      document.addEventListener("change", (event) => {
        const target = event.target;
        if (target.matches("input[type='checkbox'][data-id][data-field]")) {
          setChecked(target.dataset.id, target.dataset.field, target.checked);
          updateSummary();
        }
      });

      document.addEventListener("input", (event) => {
        const target = event.target;
        if (target.matches("textarea[data-id]")) {
          setNote(target.dataset.id, target.value);
        }
      });
    }

    init();
  </script>
</body>
</html>
