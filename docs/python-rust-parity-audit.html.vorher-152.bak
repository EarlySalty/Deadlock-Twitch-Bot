<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Python/Rust Parity Audit</title>
  <style>
    :root {
      color-scheme: light;
      --bg: #f6f7f9;
      --panel: #ffffff;
      --text: #1f2933;
      --muted: #667085;
      --border: #d8dee8;
      --accent: #1769aa;
      --accent-2: #6b4eff;
      --warn: #9a5b00;
      --ok: #0f7b45;
      --danger: #b42318;
      --shadow: 0 1px 2px rgba(16, 24, 40, 0.08);
    }

    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.45;
    }

    header.page {
      background: #102033;
      color: white;
      padding: 22px 28px;
    }

    header.page h1 {
      margin: 0 0 6px;
      font-size: clamp(1.45rem, 2vw, 2rem);
      letter-spacing: 0;
    }

    header.page p {
      max-width: 1100px;
      margin: 0;
      color: #d7e2ef;
    }

    nav {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      padding: 12px 28px;
      background: #e9edf3;
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      z-index: 10;
    }

    nav a {
      color: #12385c;
      text-decoration: none;
      border: 1px solid #c8d2df;
      background: white;
      padding: 6px 9px;
      border-radius: 4px;
      font-size: 0.92rem;
    }

    main {
      max-width: 1320px;
      margin: 0 auto;
      padding: 22px;
    }

    section {
      margin: 0 0 24px;
      padding: 18px;
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 6px;
      box-shadow: var(--shadow);
    }

    h2 {
      margin: 0 0 12px;
      font-size: 1.25rem;
      letter-spacing: 0;
    }

    h3 {
      margin: 18px 0 8px;
      font-size: 1rem;
      letter-spacing: 0;
    }

    p, ul, ol, dl { margin-top: 0; }
    li { margin: 4px 0; }

    .metrics {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
      gap: 10px;
      margin: 14px 0;
    }

    .metric {
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 12px;
      background: #fbfcfe;
    }

    .metric strong {
      display: block;
      font-size: 1.45rem;
      line-height: 1.1;
      color: #102033;
    }

    .metric span {
      color: var(--muted);
      font-size: 0.9rem;
    }

    .definitions {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 10px;
      margin: 12px 0 0;
    }

    .definition {
      border-left: 4px solid var(--accent);
      background: #f3f8fd;
      padding: 10px 12px;
    }

    .toolbar {
      display: grid;
      grid-template-columns: repeat(4, minmax(150px, 1fr)) auto;
      gap: 10px;
      align-items: end;
      margin: 12px 0 16px;
    }

    label.filter-label {
      display: grid;
      gap: 4px;
      color: var(--muted);
      font-size: 0.85rem;
      font-weight: 600;
    }

    select, input[type="search"], textarea, button {
      font: inherit;
      border: 1px solid var(--border);
      border-radius: 4px;
      background: white;
      color: var(--text);
    }

    select, input[type="search"], button {
      min-height: 36px;
      padding: 6px 8px;
    }

    button {
      cursor: pointer;
      background: #173b61;
      color: white;
      border-color: #173b61;
    }

    button.secondary {
      background: white;
      color: #173b61;
      border-color: #b9c6d4;
    }

    .hint {
      color: var(--muted);
      font-size: 0.92rem;
    }

    .finding-list {
      display: grid;
      gap: 12px;
    }

    article.finding {
      border: 1px solid var(--border);
      border-radius: 6px;
      background: white;
      overflow: hidden;
    }

    .finding-head {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 10px;
      padding: 12px 14px;
      border-bottom: 1px solid var(--border);
      background: #fbfcfe;
    }

    .finding-title {
      margin: 0;
      font-size: 1rem;
    }

    .badges {
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 6px;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 2px 8px;
      background: white;
      color: #314154;
      font-size: 0.78rem;
      white-space: nowrap;
    }

    .badge.status-unklar { border-color: #f3c36a; color: var(--warn); background: #fff8e8; }
    .badge.status-gewollt { border-color: #79c697; color: var(--ok); background: #ecfdf3; }
    .badge.status-sicher { border-color: #9ab7e5; color: #174f95; background: #eef5ff; }

    .finding-body {
      padding: 12px 14px 14px;
    }

    .fields {
      display: grid;
      grid-template-columns: repeat(2, minmax(220px, 1fr));
      gap: 10px;
      margin: 0;
    }

    .field {
      border: 1px solid #e4e8ef;
      border-radius: 4px;
      padding: 8px;
      background: #fff;
      min-width: 0;
    }

    .field dt {
      color: var(--muted);
      font-size: 0.78rem;
      font-weight: 700;
      margin: 0 0 3px;
    }

    .field dd {
      margin: 0;
      overflow-wrap: anywhere;
    }

    .tracking {
      display: grid;
      grid-template-columns: repeat(4, minmax(140px, auto)) minmax(240px, 1fr);
      gap: 10px;
      align-items: start;
      margin-top: 12px;
      padding-top: 12px;
      border-top: 1px solid #e9edf3;
    }

    .tracking label.checkbox {
      display: inline-flex;
      gap: 6px;
      align-items: center;
      min-height: 32px;
      color: #263547;
    }

    textarea {
      width: 100%;
      min-height: 62px;
      resize: vertical;
      padding: 8px;
    }

    .two-col {
      display: grid;
      grid-template-columns: repeat(2, minmax(240px, 1fr));
      gap: 14px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.95rem;
    }

    th, td {
      text-align: left;
      vertical-align: top;
      border: 1px solid var(--border);
      padding: 8px;
    }

    th { background: #eef2f7; }

    @media (max-width: 900px) {
      .toolbar, .fields, .tracking, .two-col, .finding-head {
        grid-template-columns: 1fr;
      }

      .badges {
        justify-content: flex-start;
      }

      nav {
        position: static;
      }
    }
  </style>
</head>
<body>
  <header class="page">
    <h1>Python/Rust Parity Audit</h1>
    <p>Read-only Doku-Artefakt fuer den lokalen Vergleich von Python-Verhalten in <code>bot*/scripts/ops</code> und Rust-Ziel unter <code>rust/</code>. Diese Seite dokumentiert Findings, keine Fixes.</p>
  </header>

  <nav aria-label="Abschnitte">
    <a href="#a">A Zusammenfassung</a>
    <a href="#b">B Module</a>
    <a href="#c">C Kritische Stellen</a>
    <a href="#d">D Offene Fragen</a>
    <a href="#e">E Rust-Architektur</a>
    <a href="#f">F Auditplan</a>
    <a href="#g">G Verbesserungen</a>
  </nav>

  <main>
    <section id="a">
      <h2>A Analyse-Zusammenfassung</h2>
      <p>Grundlage ist die vorgegebene Finding-Liste. Wenn keine genaue Datei genannt wurde, werden Python-Quelle und Rust-Ziel absichtlich nur auf Bereichsebene benannt, damit keine genauen Quellen erfunden werden.</p>
      <div class="metrics" aria-live="polite">
        <div class="metric"><strong id="totalFindings">0</strong><span>Findings gesamt</span></div>
        <div class="metric"><strong id="visibleFindings">0</strong><span>Findings im aktuellen Filter</span></div>
        <div class="metric"><strong id="doneFindings">0</strong><span>als erledigt markiert</span></div>
        <div class="metric"><strong id="checkedBoxes">0</strong><span>erledigte/gesetzte Checkboxes</span></div>
      </div>
      <div class="definitions">
        <div class="definition"><strong>Kategorie</strong><br>Einordnung des Paritaetsrisikos: sicher additiv, potenziell verhaltensaendernd, gewollte Sicherheitsabweichung oder offener Vertrag.</div>
        <div class="definition"><strong>Status/Typ</strong><br>Arbeitszustand fuer das Audit: offen, unklar, sicher oder gewollt. Die Checkbox "erledigt" ist der lokale Bearbeitungsstand.</div>
        <div class="definition"><strong>Gewollte Abweichung</strong><br>Eine Abweichung, die laut Git/Doku oder Vorgabe bewusst ist. Einzelne API-Gaps koennen trotzdem offen bleiben.</div>
        <div class="definition"><strong>Offene Frage</strong><br>Ein Finding, bei dem Intent, Route, Wiring oder Vertrag noch bestaetigt werden muss, bevor eine Migration als parity-clean gelten kann.</div>
      </div>

      <h3>Gewollte/positive globale Abweichungen</h3>
      <ul>
        <li>Webhook-only statt EventSub-WS ist dokumentiert/gewollt.</li>
        <li>Dashboard native API/SPAs statt Flask/SSR/NOAUTH ist grundsaetzlich gewollt; konkrete API-Gaps bleiben als Findings offen.</li>
        <li>Stripe-hosted/Connect statt eigener Rechnung/PDF/Payout kann gewollt sein; konkrete Affiliate/Billing-Routen sind teils offen.</li>
        <li>OpenAI/Whisper Drop ist dokumentiert/gewollt.</li>
        <li>Rust-only additive Features wie <code>PATCH /twitch/api/v2/channel/title</code> und diagnose/scam-guard werden als additive Abweichung bzw. offener Vertrag betrachtet.</li>
      </ul>
    </section>

    <section id="b">
      <h2>B Erkannte Module/Funktionen</h2>
      <table>
        <thead>
          <tr><th>Bereich</th><th>Python-Quelle</th><th>Rust-Ziel</th><th>Fokus im Audit</th></tr>
        </thead>
        <tbody id="moduleRows"></tbody>
      </table>
    </section>

    <section id="c">
      <h2>C Kritische Stellen</h2>
      <p class="hint">Filter und lokale Bearbeitungsfelder bleiben im Browser. Checkboxes und Notizen werden mit <code>localStorage</code> pro Finding-ID gespeichert.</p>
      <div class="toolbar">
        <label class="filter-label">Bereich
          <select id="areaFilter"><option value="">Alle Bereiche</option></select>
        </label>
        <label class="filter-label">Status/Typ
          <select id="statusFilter"><option value="">Alle Status</option></select>
        </label>
        <label class="filter-label">Kategorie
          <select id="categoryFilter"><option value="">Alle Kategorien</option></select>
        </label>
        <label class="filter-label">Textsuche
          <input id="searchFilter" type="search" placeholder="ID, Risiko, Route, Test ...">
        </label>
        <button type="button" class="secondary" id="resetFilters">Filter zuruecksetzen</button>
      </div>
      <div id="filterInfo" class="hint"></div>
      <div id="findingsList" class="finding-list"></div>
    </section>

    <section id="d">
      <h2>D Offene Fragen</h2>
      <p>Offene Fragen sind Findings mit unklarem Intent, Route, Wiring oder Vertrag. Die Liste unten wird aus dem aktuellen Datenstand erzeugt.</p>
      <ul id="openQuestions"></ul>
    </section>

    <section id="e">
      <h2>E Vorgeschlagene Rust-Architektur</h2>
      <ul>
        <li>Ports fuer Chat, Helix, DB, Discord, Billing und Durable-Inbox explizit fail-safe machen; Fehler sollen sichtbar, gezaehlt und testbar sein.</li>
        <li>Privilegierte Commands und interne Routen zentral ueber Reauth/Auth/CSRF/Idempotency-Gates fuehren.</li>
        <li>Background-Tasks und spawned Sends zentral ueberwachen, Panic/Drop/Result melden und Readiness degradieren.</li>
        <li>EventSub, Raid-Arrival und Inbox ueber idempotente Workflows mit Deadletter/Replay/Startup-Drain absichern.</li>
        <li>Dashboard-APIs als stabile JSON-Vertraege dokumentieren; gewollte SPA/API-Abweichungen separat von fehlender Paritaet halten.</li>
      </ul>
    </section>

    <section id="f">
      <h2>F Migrations-/Auditplan</h2>
      <ol>
        <li>Routen-/Command-Matrix erstellen und alle unklaren API-/Command-Gaps entscheiden.</li>
        <li>Fail-closed Tests fuer Auth, EventSub, Subscription-Coverage, DB-Fehler und Readiness priorisieren.</li>
        <li>Raid/Scoring/Arrival mit Fixtures gegen Python-Verhalten bzw. gewollte Abweichungen shadow-diffen.</li>
        <li>Dashboard/Billing/Affiliate JSON-Vertraege pruefen und gewollte Stripe-hosted/Connect-Entscheidung konkretisieren.</li>
        <li>Runtime-Cutover nur mit Migration-Preflight, Dual-Writer-Gate, Task-Supervision und Health-Checks freigeben.</li>
      </ol>
    </section>

    <section id="g">
      <h2>G Verbesserungen</h2>
      <div class="two-col">
        <div>
          <h3>Sicher ohne Verhaltensaenderung</h3>
          <ul>
            <li>Additive Logs, Access-Log-Senken und bessere Error-Details ohne Vertragsbruch.</li>
            <li>Stale Kommentare/Tests korrigieren, wenn der echte Handler vorhanden ist.</li>
            <li>Kosten-/Usage-Ledger additiv verdrahten, ohne Runtime-Entscheidungen zu aendern.</li>
            <li>Alias-Routen fuer Legal/OAuth ergaenzen, wenn bestehende Links sonst 404 liefern.</li>
          </ul>
        </div>
        <div>
          <h3>Potenziell verhaltensaendernd</h3>
          <ul>
            <li>Scope-, Cookie-, Reauth-, CSRF- und Admin-Error-Vertraege.</li>
            <li>Raid-Auswahl, Score-Rundung, Dedupe, Arrival-Replay und Fallbacks.</li>
            <li>Monitoring-Scope, Subscription-Recovery, EventSub-Validierung und Dashboard-Bridge.</li>
            <li>Billing/Affiliate-Routen, per-Streamer Live-Announcement-Config und Analytics-Zugriffsregeln.</li>
          </ul>
        </div>
      </div>
    </section>
  </main>

  <script>
    const AREA_META = {
      "Chat/IRC": {
        py: "bot*/scripts/ops (TwitchIO, IRC, Chat-Commands)",
        rust: "rust/ (Chat pipeline, IRC adapter, command/API ports)",
        focus: "Chat-Event-Shape, Commands, Engagement, IRC-Lurker, Fallbacks"
      },
      "Monitoring/EventSub": {
        py: "bot*/scripts/ops (Monitoring, EventSub, subscriptions, inbox)",
        rust: "rust/ (Webhook/EventSub, polling, durable inbox, live announcements)",
        focus: "Webhook-Validierung, Subscription-Coverage, Polling, Inbox, Raid-Events"
      },
      "Raid/OAuth/Scoring": {
        py: "bot*/scripts/ops (Raid, OAuth, scoring, recruitment, setup)",
        rust: "rust/ (Raid planner/executor, OAuth, scoring, recruitment, setup)",
        focus: "Token-Lifecycle, Score-Paritaet, Arrival-Dedupe, Raid-Ausfuehrung"
      },
      "Dashboard/Auth/Admin/API": {
        py: "bot*/scripts/ops (Dashboard/Auth/Admin/Billing/Affiliate APIs)",
        rust: "rust/ (native dashboard API/SPAs, auth, admin, billing)",
        focus: "Cookie/Auth-Vertraege, API-Routen, Billing/Affiliate, interne Tools"
      },
      "Analytics/Public/LLM": {
        py: "bot*/scripts/ops (Analytics, public endpoints, LLM/title/reporting)",
        rust: "rust/ (analytics/public API, AI report/title paths)",
        focus: "Analytics-Zugriff, KPI-Definitionen, AI-Gates, Public Pages"
      },
      "Storage/Runtime/Ops": {
        py: "bot*/scripts/ops (schema bootstrap, readiness, runtime scripts)",
        rust: "rust/ (migrations, readiness, runtime services, logging)",
        focus: "Migrationen, Readiness, Task-Supervision, Cutover"
      },
      "Engagement/Social/Highlights": {
        py: "bot*/scripts/ops (Engagement, Social, Promo, Highlights)",
        rust: "rust/ (engagement/social routes, promo send path, templates)",
        focus: "Social-Legal, Promo Self-Service, Template-Paritaet, Audit-Attribution"
      }
    };

    const DEFAULT_ASSESSMENT = "Keine globale gewollte Abweichung belegt; als Paritaetsfund pruefen.";
    const DEFAULT_CATEGORY = "potenziell verhaltensaendernd";
    const DEFAULT_STATUS = "offen";

    const FINDINGS = [
      {id:"CHAT-PIPE-002",area:"Chat/IRC",summary:"Rust deserialisiert strict ChatMessageEvent; Python normalisiert TwitchIO-3.x dynamisch.",risk:"Stille Drops bei Event-Shape.",test:"Fixture mit alternativen TwitchIO Event-Shapes."},
      {id:"CHAT-PIPE-006",area:"Chat/IRC",summary:"Python isoliert Schritte per try/except, Rust ruft Ports direkt.",risk:"Crash/Panic wenn Ports nicht fail-safe sind.",test:"Ports werfen Fehler, Chatprozess bleibt lauffaehig."},
      {id:"CHAT-PIPE-007",area:"Chat/IRC",summary:"Rust spawnt Engagement nach handle() fuer jedes Nicht-Bot-Event; Python Engagement nur nach Partner-Gate/fruehen Returns.",risk:"Non-Partner/Spam triggert Engagement.",test:"Non-Partner Event darf kein Engagement ausloesen."},
      {id:"CHAT-CMD-013",area:"Chat/IRC",summary:"!engagement_on fehlt in Rust.",risk:"Aktivierung per Chat fehlt.",test:"Command parity."},
      {id:"CHAT-CMD-014",area:"Chat/IRC",summary:"!engagement_off fehlt in Rust.",risk:"Deaktivierung per Chat fehlt.",test:"Command parity."},
      {id:"CHAT-CMD-007",area:"Chat/IRC",summary:"!silentban in Rust ohne Reauth-Gate.",risk:"Privilegierter Pfad lockerer.",test:"Expired reauth blockt."},
      {id:"CHAT-CMD-008",area:"Chat/IRC",summary:"!silentraid in Rust ohne Reauth-Gate.",risk:"Privilegierter Pfad lockerer.",test:"Expired reauth blockt."},
      {id:"CHAT-CMD-015",area:"Chat/IRC",summary:"!engagement_status Rust schluckt DB-Fehler und zeigt Null-Log anders.",risk:"Falsche Admin-Auskunft.",test:"DB-Fehler ergibt sichtbaren Fehler."},
      {id:"CHAT-API-003",area:"Chat/IRC",summary:"Announcement-Fallback fehlt oder driftet.",risk:"Chat-Mitteilung faellt bei API-Fehler anders aus.",test:"Helix/Chat Fallback."},
      {id:"CHAT-API-004",area:"Chat/IRC",summary:"Announcement-Statusdetails gehen verloren.",risk:"Debugging schwerer.",test:"Statusdetail im Error."},
      {id:"CHAT-API-011",area:"Chat/IRC",summary:"Suppression-DB-Fehler geschluckt.",risk:"Verbotene/gesperrte Pfade koennen falsch weiterlaufen.",test:"DB-Fehler fail-closed."},
      {id:"CHAT-API-013",area:"Chat/IRC",summary:"AutoBan-Notice Send-Result ignoriert.",risk:"Fehlende Benachrichtigung bleibt unsichtbar.",test:"Send-Fehler wird geloggt/gezaehlt."},
      {id:"CHAT-API-014",area:"Chat/IRC",summary:"Mutex::lock().unwrap() Poison-Panic-Risiko.",risk:"Prozesspanic.",test:"Poisoned lock simulieren."},
      {id:"CHAT-IRC-003",area:"Chat/IRC",summary:"Rust trackt alle Chatters als Category, Python differenziert.",risk:"Analytics/Lurker-Kategorien driften.",test:"Category mapping."},
      {id:"CHAT-IRC-004",area:"Chat/IRC",summary:"Kein NAMES-Stagger.",risk:"Burst/Rate-Limit beim Join.",test:"Mehrere Channels mit Timing."},
      {id:"CHAT-IRC-007",area:"Chat/IRC",summary:"DB-Fehler still.",risk:"Verlorene Lurkerdaten.",test:"DB down wird gemeldet."},
      {id:"CHAT-IRC-008",area:"Chat/IRC",summary:"get_chatters(\"#x\") leer.",risk:"Channel-Name-Format Bug.",test:"Mit/ohne #."},
      {id:"CHAT-IRC-009",area:"Chat/IRC",summary:"Kein Stop-Signal.",risk:"Unsauberes Shutdown.",test:"Graceful stop."},
      {id:"CHAT-IRC-010",area:"Chat/IRC",summary:"Chatters-Poll kann ohne TokenProvider ausfallen.",risk:"Lurker-Poll deaktiviert.",test:"Missing token provider sichtbar."},
      {id:"CHAT-IRC-013",area:"Chat/IRC",summary:"Engagement-IRC dynamisch anders verdrahtet.",risk:"Ordering/Scope-Drift.",test:"Event-Reihenfolge."},
      {id:"CHAT-IRC-014",area:"Chat/IRC",summary:"Engagement-IRC Ordering-Risiko.",risk:"Reaktionen vor Persistenz/Checks.",test:"Deterministic order."},
      {id:"CHAT-IRC-015",area:"Chat/IRC",summary:"Task-Panic-Risiko im IRC Umfeld.",risk:"Stille Teilfunktion tot.",test:"Panic supervision."},
      {id:"CHAT-IRC-016",area:"Chat/IRC",summary:"IRC-Fehlerbehandlung unvollstaendig.",risk:"Reconnect/Recovery driftet.",test:"Disconnect/reconnect."},

      {id:"MON-EVENTSUB-002",area:"Monitoring/EventSub",summary:"Rust akzeptiert fehlenden message-type teils 204.",risk:"Fehlerhafte Webhook Requests werden als OK behandelt.",test:"Missing header => 4xx."},
      {id:"MON-EVENTSUB-004",area:"Monitoring/EventSub",summary:"Challenge ohne challenge ergibt 200 leer.",risk:"Twitch-Verifikation kann falsch als Erfolg erscheinen.",test:"Malformed challenge."},
      {id:"MON-EVENTSUB-005",area:"Monitoring/EventSub",summary:"Revocation-Folgen schwaecher.",risk:"Subscription-Ausfall bleibt laenger unbemerkt.",test:"Revoked event markiert Zustand."},
      {id:"MON-EVENTSUB-009",area:"Monitoring/EventSub",summary:"Direct dispatch kann unknown droppen.",risk:"Eventverlust ohne DLQ.",test:"Unknown type sichtbar."},
      {id:"MON-EVENTSUB-013",area:"Monitoring/EventSub",summary:"Fehlende broadcaster_id kann leer verarbeitet werden.",risk:"Falsche Zuordnung.",test:"Missing broadcaster fail-closed."},
      {id:"MON-SUB-002",area:"Monitoring/EventSub",summary:"Rust core subscription ensure best-effort ohne Fehlerstatus; Python startup coverage fail-closed.",risk:"Bot startet ohne Coverage.",test:"Ensure failure => unhealthy."},
      {id:"MON-SUB-005",area:"Monitoring/EventSub",summary:"401 nur debug und 6h reconcile.",risk:"Lange Event-Luecke.",test:"401 triggert schnelle Reparatur."},
      {id:"MON-SUB-006",area:"Monitoring/EventSub",summary:"429 nur debug und 6h reconcile.",risk:"Lange Event-Luecke.",test:"Backoff/retry sichtbar."},
      {id:"MON-SUB-010",area:"Monitoring/EventSub",summary:"403 perm_failed bis Neustart.",risk:"Permanenter Eventverlust.",test:"403 Recovery."},
      {id:"MON-SUB-012",area:"Monitoring/EventSub",summary:"Capacity Rust schreibt nur used_slots; Dashboard/Alerts weniger aussagekraeftig.",risk:"Weniger Capacity-Diagnose.",test:"Capacity Felder."},
      {id:"MON-POLL-002",area:"Monitoring/EventSub",summary:"Rust tracked alle Nicht-Partner aus twitch_streamers, Python nur is_monitored_only=1.",risk:"Monitoring-Scope driftet.",test:"Fixture Partner/Monitored."},
      {id:"MON-POLL-003",area:"Monitoring/EventSub",summary:"API-Fehler kann live Kanaele als offline behandeln.",risk:"Falsche Offline-Events.",test:"API error preserves live state."},
