      {id:"ENG-SOCIAL-001",area:"Engagement/Social/Highlights",summary:"Social-Legal-Aliases fehlen; Rust Templates linken /privacy und /terms, Router nur /social-media/*.",risk:"404 bei Legal/OAuth.",test:"Alias route/template links.",cat:"sicher ohne Verhaltensaenderung",status:"sicher",assessment:"Additive Alias-Routen sind sicher, solange bestehende Routen unveraendert bleiben."},
      {id:"ENG-SOCIAL-002",area:"Engagement/Social/Highlights",summary:"Streamer-Promo-Message Self-Service /twitch/abbo/promo-message fehlt nativ.",risk:"Streamer koennen Promo nicht setzen/clearen.",test:"Partner POST updates DB."},
