  "query": "\n        SELECT streamer_login AS \"streamer_login!\",\n               AVG(avg_viewers)::FLOAT8 AS val\n          FROM twitch_stream_sessions\n         WHERE started_at > NOW() - ($1::INT * INTERVAL '1 day')\n         GROUP BY streamer_login\n         ORDER BY val DESC\n         LIMIT 5\n        ",
