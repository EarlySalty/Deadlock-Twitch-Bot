{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT message_ts AS \"message_ts!\",\n               content,\n               is_command,\n               chatter_login,\n               chatter_id\n        FROM twitch_chat_messages\n        WHERE message_ts >= $1\n          AND LOWER(streamer_login) = $2\n          AND (chatter_login IS NULL OR chatter_login = '' OR LOWER(chatter_login) <> ALL($3))\n        ",
