  "query": "\n        SELECT s.duration_seconds AS \"duration_seconds!\",\n               s.avg_viewers::float8 AS avg_viewers,\n               s.unique_chatters,\n               s.retention_5m::float8 AS retention_5m\n        FROM twitch_stream_sessions s\n        WHERE s.streamer_login = $1\n          AND s.started_at >= $2\n          AND s.duration_seconds > 300\n        ",
