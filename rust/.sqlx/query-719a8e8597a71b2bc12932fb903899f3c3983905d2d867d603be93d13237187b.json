{
  "db_name": "PostgreSQL",
  "query": "SELECT a.id::bigint AS \"id!\", a.session_id::bigint AS \"session_id!\", a.started_at AS \"started_at!\", a.duration_seconds, a.is_automatic, s.started_at AS \"session_started_at?\" FROM twitch_ad_break_events a JOIN twitch_stream_sessions s ON s.id = a.session_id WHERE a.started_at >= $1 AND a.session_id IS NOT NULL AND ($2 = '' OR LOWER(s.streamer_login) = $2) ORDER BY a.started_at DESC LIMIT 200",
