[Unit]
Description=Deadlock Twitch Discord-Hub (gehärtete Rust-Laufzeit)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
User=twitchhub
Group=twitchhub
WorkingDirectory=/opt/deadlock/twitch/current
ExecStartPre=/usr/local/libexec/wait-for-infisical
ExecStart=/usr/bin/bash /opt/deadlock/twitch/current/ops/systemd/run-discord-hub
Restart=always
RestartSec=5
TimeoutStopSec=20
KillMode=mixed
LoadCredentialEncrypted=infisical-token:/etc/credstore.encrypted/deadlock-twitch-infisical.cred
RuntimeDirectory=deadlock-twitch-discord-hub
RuntimeDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProcSubset=pid
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
UMask=0077
LimitCORE=0

[Install]
WantedBy=multi-user.target
