[Unit]
Description=Deadlock lokaler STT-Dienst (Rust/whisper.cpp, Loopback)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/home/nathanael
Environment=STT_HOST=127.0.0.1
Environment=STT_PORT=8791
Environment=STT_MODEL=/home/nathanael/stt-models/ggml-large-v3-turbo-q5_0.bin
Environment=STT_MODEL_LABEL=ggml-large-v3-turbo-q5_0
Environment=STT_THREADS=8
Environment=STT_MAX_PARALLEL=1
Environment=RUST_LOG=tb_stt_server=info
ExecStart=/home/nathanael/stt-tools/bin/tb-stt-server
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=30
KillMode=mixed

# Der Host ist gleichzeitig interaktiver RDP-Desktop. Whisper darf alle acht
# Threads nutzen, wenn CPU frei ist, muss aber sofort hinter interaktive Last
# zurueckfallen. So bleibt Durchsatz hoch, ohne RDP-Spikes zu erzeugen.
Nice=10
CPUWeight=20
IOWeight=20
IOSchedulingClass=idle
OOMScoreAdjust=200
TasksMax=128

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=default.target
