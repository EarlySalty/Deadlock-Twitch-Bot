[Unit]
Description=Deadlock global category collector (anonymous read-only IRC)
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service
OnFailure=tb-category-collector-failure.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
User=twitchcollector
Group=twitchcollector
WorkingDirectory=/opt/deadlock/twitch/current
ExecStart=/opt/deadlock/twitch/current/rust/target/release/tb-category-collector --config /etc/deadlock-twitch/category-collector.json
LoadCredentialEncrypted=category-twitch:/etc/credstore.encrypted/deadlock-category-twitch.cred
Restart=on-failure
RestartSec=30
TimeoutStopSec=30
KillSignal=SIGTERM
MemoryMax=512M
CPUQuota=100%
TasksMax=64
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProcSubset=pid
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
LimitCORE=0

[Install]
WantedBy=multi-user.target
