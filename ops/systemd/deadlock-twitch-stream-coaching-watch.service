[Unit]
Description=Deadlock Twitch autorisiertes Stream-Coaching-Audit
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=twitchaudit
Group=twitchaudit
SupplementaryGroups=twitchstt
WorkingDirectory=/opt/deadlock/twitch/current
ExecStartPre=/usr/local/libexec/wait-for-infisical
ExecStart=/usr/bin/bash /opt/deadlock/twitch/current/rust/scripts/run_stream_audit_service.sh
Restart=on-failure
RestartSec=30
TimeoutStopSec=90
KillMode=mixed

LoadCredentialEncrypted=infisical-token:/etc/credstore.encrypted/deadlock-twitch-infisical.cred
LoadCredentialEncrypted=rclone-config:/etc/credstore.encrypted/deadlock-twitch-rclone.cred
Environment=HOME=/var/lib/deadlock-twitch-audit
Environment=INFISICAL_CONFIG_FILE=/etc/deadlock-twitch/infisical.conf
Environment=INFISICAL_LOADER=/usr/local/libexec/dl-infisical-env
Environment=TWITCH_RUNTIME_CONFIG_FILE=/etc/deadlock-twitch/audit.conf
Environment=RCLONE_CONFIG=%d/rclone-config

StateDirectory=deadlock-twitch-audit
StateDirectoryMode=0700
CacheDirectory=deadlock-twitch-audit
CacheDirectoryMode=0700
LogsDirectory=deadlock-twitch-audit
LogsDirectoryMode=0700
RuntimeDirectory=deadlock-twitch-audit
RuntimeDirectoryMode=0700
# Aufnahme, Status und Berichte verwenden den stabilen StateDirectory-Pfad
# aus audit.conf. Keine Bind-Mounts auf current: systemd löst den Symlink nur
# beim Start auf, während der nächste Deploy bereits auf ein neues Release zeigt.

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProcSubset=pid
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
UMask=0077
LimitCORE=0

[Install]
WantedBy=multi-user.target
