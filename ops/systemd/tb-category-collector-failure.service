[Unit]
Description=Notify operator about failed anonymous category collector
StartLimitIntervalSec=0

[Service]
Type=oneshot
DynamicUser=yes
StateDirectory=tb-category-notify
ExecStart=/usr/local/libexec/tb-category-notify
LoadCredentialEncrypted=category-notify:/etc/credstore.encrypted/deadlock-category-notify.cred
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
CapabilityBoundingSet=
UMask=0077
TimeoutStartSec=25
LimitCORE=0
