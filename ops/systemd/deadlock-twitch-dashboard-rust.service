[Unit]
Description=Deadlock Twitch Dashboard (gehärtete Rust-Laufzeit)
After=network-online.target postgresql.service docker.service deadlock-twitch-bot-rust.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=twitchdash
Group=twitchdash
SupplementaryGroups=twitchmedia
WorkingDirectory=/opt/deadlock/twitch/current
ExecStartPre=/usr/local/libexec/wait-for-infisical
ExecStart=/usr/bin/bash /opt/deadlock/twitch/current/rust/scripts/run_tb_dashboard_service.sh
Restart=always
RestartSec=5
TimeoutStopSec=20
KillMode=mixed

LoadCredentialEncrypted=infisical-token:/etc/credstore.encrypted/deadlock-twitch-infisical.cred
Environment=HOME=/var/lib/deadlock-twitch-dashboard
Environment=INFISICAL_CONFIG_FILE=/etc/deadlock-twitch/infisical.conf
Environment=INFISICAL_LOADER=/usr/local/libexec/dl-infisical-env
Environment=TWITCH_RUNTIME_CONFIG_FILE=/etc/deadlock-twitch/dashboard.conf
Environment=TWITCH_RUNTIME_ROLE=dashboard
Environment=TWITCH_RUNTIME_ENFORCE=1
Environment=TWITCH_SPLIT_RUNTIME_ENFORCE=1
Environment=DASHBOARD_PORT=8769
Environment=TB_DB_MIGRATE=0
Environment=TWITCH_RUNTIME_PID_LOCK_DIR=/run/deadlock-twitch-dashboard

RuntimeDirectory=deadlock-twitch-dashboard
RuntimeDirectoryMode=0700
StateDirectory=deadlock-twitch-dashboard
StateDirectoryMode=0700
CacheDirectory=deadlock-twitch-dashboard
CacheDirectoryMode=0700
LogsDirectory=deadlock-twitch-dashboard
LogsDirectoryMode=0700
BindPaths=/var/lib/deadlock-twitch-dashboard/data:/opt/deadlock/twitch/current/data
BindPaths=/var/log/deadlock-twitch-dashboard:/opt/deadlock/twitch/current/logs
BindPaths=/var/lib/deadlock-twitch-media/clips:/opt/deadlock/twitch/current/data/clips

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProcSubset=pid
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
UMask=0007
LimitCORE=0

[Install]
WantedBy=multi-user.target
