#!/usr/bin/env bash
set -euo pipefail
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

usage() {
  cat >&2 <<'EOF'
Aufruf:
  deploy-twitch-release <40-stelliger-git-sha> [quell-checkout]
  deploy-twitch-release <40-stelliger-git-sha> [quell-checkout] --restart <dienst> [--restart <dienst> ...]

Ohne --restart werden wie bisher Dashboard, Bot und Coaching-Watch neu gestartet.
Mit --restart werden nur die explizit genannten Twitch-Dienste neu gestartet.

Erlaubte Restart-Ziele:
  twitch-dashboard
  twitch-bot
  twitch-audit
  coaching-watch
  category-collector
  all
EOF
}

# Hebt sich bei Bedarf genau einmal per sudo nach root. So braucht die
# codex-mcp-Allowlist nur diesen einen Befehl statt generisches sudo.
if [[ $EUID -ne 0 ]]; then
  exec sudo -n /usr/local/bin/deploy-twitch-release "$@"
fi

if [[ $# -eq 1 && "$1" == --brain-inspect ]]; then
  exec /opt/deadlock/twitch/current/rust/target/release/tb-config-check --config /var/lib/deadlock-twitch/config/bot.toml --brain-inspect
fi
if [[ $# -eq 3 && "$1" == --brain-apply && "$2" == --expected-revision && "$3" =~ ^[0-9a-f]{64}$ ]]; then
  exec /opt/deadlock/twitch/current/rust/target/release/tb-config-check --config /var/lib/deadlock-twitch/config/bot.toml --brain-apply --expected-revision "$3"
fi

sha="${1:-}"
if [[ ! "$sha" =~ ^[0-9a-f]{40}$ ]]; then
  usage
  exit 1
fi
shift

exec 9>/run/lock/deploy-twitch-release.lock
if ! flock -n 9; then
  echo "Deploy-Sperre belegt, warte bis zu 15 Minuten." >&2
  if ! flock -w 900 9; then
    echo "Ein anderer Deploy läuft seit über 15 Minuten, Abbruch." >&2
    exit 75
  fi
fi

src=""
restart_explicit=0
declare -a restart_targets=()
declare -A restart_seen=()

add_restart_target() {
  local raw="$1"
  local canonical=""
  case "$raw" in
    twitch-dashboard|dashboard|deadlock-twitch-dashboard-rust|deadlock-twitch-dashboard-rust.service)
      canonical="twitch-dashboard"
      ;;
    twitch-bot|bot|deadlock-twitch-bot-rust|deadlock-twitch-bot-rust.service)
      canonical="twitch-bot"
      ;;
    twitch-audit|coaching-watch|twitch-coaching-watch|deadlock-twitch-stream-coaching-watch|deadlock-twitch-stream-coaching-watch.service)
      canonical="coaching-watch"
      ;;
    category-collector|tb-category-collector|tb-category-collector.service)
      canonical="category-collector"
      ;;
    all)
      add_restart_target twitch-dashboard
      add_restart_target twitch-bot
      add_restart_target coaching-watch
      if [[ -f /etc/systemd/system/tb-category-collector.service ]]; then add_restart_target category-collector; fi
      return
      ;;
    *)
      echo "Restart-Ziel nicht erlaubt: $raw" >&2
      usage
      exit 1
      ;;
  esac

  if [[ -z "${restart_seen[$canonical]:-}" ]]; then
    restart_seen[$canonical]=1
    restart_targets+=("$canonical")
  fi
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --restart)
      if [[ $# -lt 2 ]]; then
        echo "--restart braucht ein Ziel." >&2
        usage
        exit 1
      fi
      if [[ $restart_explicit -eq 0 ]]; then
        restart_explicit=1
        restart_targets=()
        restart_seen=()
      fi
      add_restart_target "$2"
      shift 2
      ;;
    --restart=*)
      if [[ $restart_explicit -eq 0 ]]; then
        restart_explicit=1
        restart_targets=()
        restart_seen=()
      fi
      add_restart_target "${1#--restart=}"
      shift
      ;;
    --)
      shift
      if [[ $# -gt 1 ]]; then
        echo "Zu viele Positionsargumente." >&2
        usage
        exit 1
      fi
      if [[ $# -eq 1 ]]; then
        if [[ -n "$src" ]]; then
          echo "Quell-Checkout wurde mehrfach angegeben." >&2
          usage
          exit 1
        fi
        src="$1"
        shift
      fi
      ;;
    -*)
      echo "Unbekannte Option: $1" >&2
      usage
      exit 1
      ;;
    *)
      if [[ -n "$src" ]]; then
        echo "Zu viele Positionsargumente: $1" >&2
        usage
        exit 1
      fi
      src="$1"
      shift
      ;;
  esac
done

if [[ $restart_explicit -eq 0 ]]; then
  add_restart_target all
fi
if [[ ${#restart_targets[@]} -eq 0 ]]; then
  echo "Mindestens ein Restart-Ziel ist erforderlich." >&2
  exit 1
fi

src="${src:-/home/nathanael/repos/twitch-release-$sha}"
dest="/opt/deadlock/twitch/builds/$sha"

if [[ -L "$src" || ! -d "$src" ]]; then
  echo "Quell-Checkout fehlt oder ist ein Symlink: $src" >&2
  exit 1
fi
if [[ -L "$src/.git" || ! -d "$src/.git" ]]; then
  echo "Quell-Checkout muss vor dem Verschieben ein eigenständiger Clone mit internem .git-Verzeichnis sein: $src" >&2
  exit 1
fi

required_artifacts=(
  rust/target/release/tb-bot
  rust/target/release/tb-dashboard
  rust/target/release/tb-stream-audit
  rust/target/release/tb-config-check
  rust/target/release/tb-llm-usage-recover
  bot/analytics/dashboard_v2/dist
  bot/admin_dashboard/dist
  website/dist
)
if [[ -f "$src/rust/bin/tb-category-collector/Cargo.toml" ]]; then
  required_artifacts+=(rust/target/release/tb-category-collector)
fi
if [[ -f "$src/rust/bin/tb-category-collector/src/bin/tb-twitch-watchdog.rs" ]]; then
  required_artifacts+=(rust/target/release/tb-twitch-watchdog)
fi
if [[ -f "$src/rust/bin/tb-dashboard/src/bin/clip_context_learn.rs" ]]; then
  required_artifacts+=(rust/target/release/clip_context_learn)
fi
for artifact in "${required_artifacts[@]}"; do
  if [[ ! -e "$src/$artifact" ]]; then
    echo "Release-Artefakt fehlt vor dem Verschieben: $artifact" >&2
    exit 1
  fi
done

if [[ -e "$dest" || -L "$dest" ]]; then
  echo "Zielverzeichnis existiert schon: $dest" >&2
  exit 1
fi

mv -- "$src" "$dest"
chown -R root:root "$dest"
chmod -R go-w "$dest"

current=/opt/deadlock/twitch/current
release_root=/opt/deadlock/twitch/releases
previous_release=""
previous_link=""
candidate="$release_root/$sha"
verification_pending=1

# Der bestehende Installer aktiviert vor der Migration. Bei einem Fehler vor
# unserer Abnahme wird der frühere Link wiederhergestellt. Ein automatischer
# Dienststart im kurzen Aktivierungszeitraum wird dadurch nicht ausgeschlossen.
for directory in /opt /opt/deadlock /opt/deadlock/twitch "$release_root"; do
  if [[ ! -d "$directory" || -L "$directory" || $(stat -c %u "$directory") != 0 ]] ||
     [[ -n $(find "$directory" -maxdepth 0 -perm /022 -print) ]]; then
    echo "Release-Elternverzeichnis ist nicht ausschließlich rootkontrolliert: $directory" >&2
    exit 1
  fi
done
if [[ -L "$current" ]]; then
  previous_link=$(readlink -- "$current")
  if [[ "$previous_link" =~ ^releases/[0-9a-f]{8,40}(-dashboard-[0-9a-f]{8,40})?$ ]]; then
    previous_release="/opt/deadlock/twitch/$previous_link"
  elif [[ "$previous_link" =~ ^/opt/deadlock/twitch/releases/[0-9a-f]{8,40}(-dashboard-[0-9a-f]{8,40})?$ ]]; then
    previous_release="$previous_link"
  else
    echo "Bisheriger Release-Link hat ein unerwartetes Ziel." >&2
    exit 1
  fi
  if [[ $(stat -c %u "$current") != 0 || ! "$previous_release" =~ ^/opt/deadlock/twitch/releases/[0-9a-f]{8,40}(-dashboard-[0-9a-f]{8,40})?$ ||
        ! -d "$previous_release" || -L "$previous_release" || $(stat -c %u "$previous_release") != 0 ]] ||
     [[ -n $(find "$previous_release" -maxdepth 0 -perm /022 -print) ]]; then
    echo "Bisheriger Release-Link ist nicht sicher rückstellbar." >&2
    exit 1
  fi
elif [[ -e "$current" ]]; then
  echo "current ist kein Release-Symlink." >&2
  exit 1
fi

restore_unverified_release() {
  local result=$? temporary=""
  trap - EXIT
  if [[ $verification_pending -eq 1 && -L "$current" ]] &&
     [[ $(readlink -- "$current") == "$candidate" || $(readlink -- "$current") == "releases/$sha" ]]; then
    if [[ -n "$previous_release" ]]; then
      temporary=$(mktemp -d /opt/deadlock/twitch/.rollback.XXXXXXXX) || exit 1
      if ln -s -- "$previous_link" "$temporary/current" && mv -Tf -- "$temporary/current" "$current"; then
        echo "Ungeprüfter Release-Link auf bisherigen Stand zurückgestellt; Migrationen bleiben erhalten." >&2
      else
        echo "FEHLER: Bisheriger Release-Link konnte nicht wiederhergestellt werden." >&2
        result=1
      fi
      rmdir -- "$temporary" || result=1
    else
      rm -- "$current" || result=1
      echo "Ungeprüfter Release-Link entfernt; vorher war kein Release aktiv." >&2
    fi
  fi
  exit "$result"
}
trap restore_unverified_release EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

/usr/local/sbin/install-twitch-release "$dest" "$sha"

# Das Release ist jetzt unter /opt/deadlock/twitch/current aktiv. Schema zuerst
# mit dem eng begrenzten postgres-One-shot auf den Release-Stand bringen; erst
# danach dürfen Dashboard/Bot mit dem neuen Code starten. Ein Migrationsfehler
# bricht den Deploy wegen `set -e` ab statt einen halbfertigen Release zu starten.
systemctl start deadlock-twitch-migrate.service

# Der Peerinstaller stammt aus demselben geprüften Gitarchiv wie die Rollenmatrix.
# Die feste SHA-Adresse vermeidet Änderungen am current-Link während des Aufrufs.
peer_installer="/opt/deadlock/twitch/releases/$sha/ops/systemd/install-twitch-contest-peer"
if [[ ! -f "$peer_installer" || -L "$peer_installer" ]]; then
  echo "Geprüfter Peerinstaller fehlt im Release: $peer_installer" >&2
  exit 1
fi

# Feste Verbindungen ohne Nutzer-psqlrc, Passwortdatei oder geerbte PG-Optionen.
# Alle SQL-Proben sind lesend und begrenzt; es werden keine Nutzerdaten abgefragt.
local_psql() {
  local os_user="$1" database="$2" database_user="$3"
  shift 3
  runuser -u "$os_user" -- /usr/bin/env -i /usr/bin/psql --no-psqlrc --no-password \
    "host=/var/run/postgresql port=5432 dbname=$database user=$database_user passfile=/dev/null connect_timeout=5 options='-c statement_timeout=10000 -c default_transaction_read_only=on'" \
    -v ON_ERROR_STOP=1 -At "$@"
}
before_reload=$(local_psql postgres twitch_analytics postgres -c "SELECT extract(epoch FROM pg_conf_load_time())")
[[ "$before_reload" =~ ^[0-9]+([.][0-9]+)?$ ]] || { echo "Ungültiger PostgreSQL-Ladezeitpunkt." >&2; exit 1; }
/bin/bash "$peer_installer"

reload_observed=0
for ((attempt=0; attempt<30; attempt++)); do
  if [[ $(local_psql postgres twitch_analytics postgres -c "SELECT extract(epoch FROM pg_conf_load_time()) > $before_reload") == t ]]; then
    reload_observed=1
    break
  fi
  sleep 1
done
[[ $reload_observed -eq 1 ]] || { echo "PostgreSQL hat die Peerregeln nicht nachweislich neu geladen." >&2; exit 1; }

local_psql postgres twitch_analytics postgres <<'SQL'
BEGIN READ ONLY;
DO $verification$
DECLARE r text; t text; p text;
BEGIN
    IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname='twitchanalysis' AND rolcanlogin AND
        NOT (rolsuper OR rolinherit OR rolcreatedb OR rolcreaterole OR rolreplication OR rolbypassrls))
        OR EXISTS (SELECT FROM pg_auth_members WHERE roleid='twitchanalysis'::regrole OR member='twitchanalysis'::regrole) THEN
        RAISE EXCEPTION 'Analysewriter: Rollenattribute oder Mitgliedschaften falsch';
    END IF;
    IF NOT has_database_privilege('twitchanalysis','twitch_analytics','CONNECT') OR
        NOT has_schema_privilege('twitchanalysis','public','USAGE') OR
        EXISTS (SELECT FROM pg_namespace WHERE nspname NOT LIKE 'pg_%' AND nspname <> 'information_schema'
            AND has_schema_privilege('twitchanalysis',oid,'CREATE')) THEN
        RAISE EXCEPTION 'Analysewriter: Datenbank- oder Schemarechte falsch';
    END IF;
    FOREACH t IN ARRAY ARRAY['twitch_ai_chat_sessions','twitch_ai_chat_hourly','twitch_ai_chat_reservations'] LOOP
        FOREACH p IN ARRAY ARRAY['SELECT','INSERT','UPDATE','DELETE'] LOOP
            IF NOT has_table_privilege('twitchanalysis','public.'||t,p) THEN
                RAISE EXCEPTION 'Analysewriter ohne % auf %',p,t;
            END IF;
        END LOOP;
        FOREACH r IN ARRAY ARRAY['twitchbot','twitchdash','twitchlegacy','twitchcontest','twitchcollector'] LOOP
            IF EXISTS (SELECT FROM pg_roles WHERE rolname=r) AND
                (has_table_privilege(r,'public.'||t,'SELECT,INSERT,UPDATE,DELETE,TRUNCATE,REFERENCES,TRIGGER') OR
                 has_any_column_privilege(r,'public.'||t,'SELECT,INSERT,UPDATE,REFERENCES')) THEN
                RAISE EXCEPTION 'Fremdes Staterecht für % auf %',r,t;
            END IF;
        END LOOP;
        IF has_table_privilege('twitchanalysis','public.'||t,'TRUNCATE,REFERENCES,TRIGGER') OR
            (SELECT relowner='twitchanalysis'::regrole FROM pg_class WHERE oid=('public.'||t)::regclass) THEN
            RAISE EXCEPTION 'Analysewriter hat zusätzliche Rechte auf %',t;
        END IF;
    END LOOP;
    FOREACH p IN ARRAY ARRAY['SELECT','INSERT','UPDATE'] LOOP
        IF NOT has_table_privilege('twitchanalysis','public.llm_usage',p) THEN
            RAISE EXCEPTION 'Verbrauchswriter ohne % auf llm_usage',p;
        END IF;
    END LOOP;
    IF has_table_privilege('twitchanalysis','public.llm_usage','DELETE,TRUNCATE,REFERENCES,TRIGGER') OR
        (SELECT relowner='twitchanalysis'::regrole FROM pg_class WHERE oid='public.llm_usage'::regclass) OR
        NOT has_sequence_privilege('twitchanalysis','public.llm_usage_id_seq','USAGE') OR
        NOT has_sequence_privilege('twitchanalysis','public.llm_usage_id_seq','SELECT') OR
        has_sequence_privilege('twitchanalysis','public.llm_usage_id_seq','UPDATE') THEN
        RAISE EXCEPTION 'Verbrauchswriter hat unzulässige Rechte';
    END IF;
    IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname='twitchaudit' AND rolcanlogin AND
        NOT(rolsuper OR rolinherit OR rolcreatedb OR rolcreaterole OR rolreplication OR rolbypassrls)) OR
        EXISTS(SELECT FROM pg_auth_members WHERE roleid='twitchaudit'::regrole OR member='twitchaudit'::regrole) THEN
        RAISE EXCEPTION 'Auditverbrauch: unzulässige Rollenattribute oder Mitgliedschaften';
    END IF;
    FOREACH p IN ARRAY ARRAY['SELECT','INSERT','UPDATE'] LOOP
        IF NOT has_table_privilege('twitchaudit','public.llm_usage',p) THEN
            RAISE EXCEPTION 'Auditverbrauch ohne % auf llm_usage',p;
        END IF;
    END LOOP;
    IF
        has_table_privilege('twitchaudit','public.llm_usage','DELETE,TRUNCATE,REFERENCES,TRIGGER') OR
        NOT has_sequence_privilege('twitchaudit','public.llm_usage_id_seq','USAGE') OR
        NOT has_sequence_privilege('twitchaudit','public.llm_usage_id_seq','SELECT') OR
        has_sequence_privilege('twitchaudit','public.llm_usage_id_seq','UPDATE') OR
        has_schema_privilege('twitchaudit','public','CREATE') THEN
        RAISE EXCEPTION 'Auditverbrauch: Ledgerrechte falsch';
    END IF;
    IF EXISTS(SELECT FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace
        WHERE n.nspname='public' AND c.relkind IN('r','p','v','m','f') AND c.relname<>'llm_usage'
        AND has_table_privilege('twitchaudit',c.oid,'INSERT,UPDATE,DELETE,TRUNCATE,REFERENCES,TRIGGER')) THEN
        RAISE EXCEPTION 'Auditverbrauch: fremde Schreibrechte';
    END IF;
    -- Vorhandenes PUBLIC SELECT auf echte Timescale-Metadaten gehört zum
    -- Extensionbestand. Anwendungsdaten, Chunks, Direktgrants und sämtliche
    -- zusätzlichen Schreibrechte bleiben auch dort ausgeschlossen.
    IF EXISTS (
        WITH extension_metadata AS (
            SELECT c.oid FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace
            WHERE c.relkind IN ('r','p','v','m','f') AND EXISTS (
                SELECT FROM pg_depend d JOIN pg_extension e ON e.oid=d.refobjid
                WHERE d.classid='pg_class'::regclass AND d.objid=c.oid AND d.objsubid=0
                  AND d.refclassid='pg_extension'::regclass AND d.deptype='e' AND e.extname='timescaledb'
            ) AND NOT EXISTS (
                SELECT FROM _timescaledb_catalog.chunk ch WHERE ch.relid::oid=c.oid
            )
        ), relation_rights AS (
            SELECT c.oid,c.relkind,
                (c.oid IN (SELECT oid FROM extension_metadata) OR (c.relkind='S' AND EXISTS (
                    SELECT FROM pg_depend d WHERE d.classid='pg_class'::regclass AND d.objid=c.oid
                      AND d.objsubid=0 AND d.refclassid='pg_class'::regclass AND d.deptype IN ('a','i')
                      AND d.refobjsubid>0 AND d.refobjid IN (SELECT oid FROM extension_metadata)
                )) OR (c.relkind='S' AND EXISTS (
                    SELECT FROM pg_depend d JOIN pg_extension e ON e.oid=d.refobjid
                    WHERE d.classid='pg_class'::regclass AND d.objid=c.oid AND d.objsubid=0
                      AND d.refclassid='pg_extension'::regclass AND d.deptype='e' AND e.extname='timescaledb'
                ))) AS is_extension_metadata,
                EXISTS (SELECT FROM aclexplode(coalesce(c.relacl,acldefault(
                    CASE WHEN c.relkind='S' THEN 's'::"char" ELSE 'r'::"char" END,c.relowner))) a
                    WHERE a.grantee=0 AND a.privilege_type='SELECT') AS public_select,
                (EXISTS (SELECT FROM aclexplode(coalesce(c.relacl,acldefault(
                    CASE WHEN c.relkind='S' THEN 's'::"char" ELSE 'r'::"char" END,c.relowner))) a
                    WHERE a.grantee='twitchanalysis'::regrole) OR EXISTS (
                        SELECT FROM pg_attribute att CROSS JOIN LATERAL aclexplode(att.attacl) a
                        WHERE att.attrelid=c.oid AND a.grantee='twitchanalysis'::regrole
                    )) AS direct_writer_grant
            FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace
            WHERE n.nspname NOT IN ('pg_catalog','information_schema') AND n.nspname NOT LIKE 'pg_toast%'
              AND c.relkind IN ('r','p','v','m','f','S')
              AND NOT (n.nspname='public' AND c.relname=ANY(ARRAY[
                  'twitch_ai_chat_sessions','twitch_ai_chat_hourly','twitch_ai_chat_reservations',
                  'llm_usage','llm_usage_id_seq']))
        )
        SELECT FROM relation_rights r WHERE r.direct_writer_grant OR CASE WHEN r.relkind='S' THEN
            has_sequence_privilege('twitchanalysis',r.oid,'USAGE,UPDATE') OR
            (has_sequence_privilege('twitchanalysis',r.oid,'SELECT') AND NOT (r.is_extension_metadata AND r.public_select))
        ELSE
            has_table_privilege('twitchanalysis',r.oid,'INSERT,UPDATE,DELETE,TRUNCATE,REFERENCES,TRIGGER') OR
            has_any_column_privilege('twitchanalysis',r.oid,'INSERT,UPDATE,REFERENCES') OR
            ((has_table_privilege('twitchanalysis',r.oid,'SELECT') OR has_any_column_privilege('twitchanalysis',r.oid,'SELECT'))
                AND NOT (r.is_extension_metadata AND r.public_select))
        END
    ) THEN
        RAISE EXCEPTION 'Analysewriter besitzt fremde Tabellen-, Spalten- oder Sequenzrechte';
    END IF;
    FOREACH p IN ARRAY ARRAY['SELECT','INSERT','UPDATE','DELETE'] LOOP
        IF NOT has_table_privilege('twitchbot','public.twitch_raid_ad_vorlauf',p) THEN
            RAISE EXCEPTION 'Bot ohne Raidrecht %',p;
        END IF;
    END LOOP;
    FOREACH r IN ARRAY ARRAY['twitchdash','twitchlegacy','twitchcontest','twitchcollector','twitchanalysis'] LOOP
        IF EXISTS (SELECT FROM pg_roles WHERE rolname=r) AND
            (has_table_privilege(r,'public.twitch_raid_ad_vorlauf','SELECT,INSERT,UPDATE,DELETE,TRUNCATE,REFERENCES,TRIGGER') OR
             has_any_column_privilege(r,'public.twitch_raid_ad_vorlauf','SELECT,INSERT,UPDATE,REFERENCES')) THEN
            RAISE EXCEPTION 'Fremdes Raidrecht für %',r;
        END IF;
    END LOOP;
    IF NOT EXISTS (SELECT FROM pg_proc WHERE oid='public.finish_raid_ad_vorlauf_on_arrival()'::regprocedure
        AND prosecdef AND proowner='postgres'::regrole AND proconfig @> ARRAY['search_path=pg_catalog']) OR
        EXISTS (SELECT FROM pg_proc p CROSS JOIN LATERAL aclexplode(coalesce(p.proacl,acldefault('f',p.proowner))) a
            WHERE p.oid='public.finish_raid_ad_vorlauf_on_arrival()'::regprocedure AND a.grantee=0 AND a.privilege_type='EXECUTE') THEN
        RAISE EXCEPTION 'Arrivaltrigger ist nicht korrekt gehärtet';
    END IF;
    IF NOT EXISTS (SELECT FROM pg_trigger WHERE tgname='finish_raid_ad_vorlauf_on_arrival'
        AND tgrelid='public.twitch_raid_arrival_tracking'::regclass
        AND tgfoid='public.finish_raid_ad_vorlauf_on_arrival()'::regprocedure
        AND tgenabled IN ('O','A') AND tgtype=5 AND tgqual IS NULL AND tgnargs=0 AND NOT tgisinternal) THEN
        RAISE EXCEPTION 'Arrivaltrigger ist nicht als unbedingter AFTER INSERT ROW gebunden';
    END IF;
    IF EXISTS (SELECT FROM pg_hba_file_rules WHERE error IS NOT NULL) OR
       EXISTS (SELECT FROM pg_ident_file_mappings WHERE error IS NOT NULL) THEN
        RAISE EXCEPTION 'PostgreSQL meldet HBA- oder Ident-Parsefehler';
    END IF;
    IF (SELECT count(*) FROM pg_ident_file_mappings WHERE map_name='twitch_analysis_writer') <> 1 OR
        NOT EXISTS (SELECT FROM pg_ident_file_mappings WHERE map_name='twitch_analysis_writer'
            AND sys_name='twitchdash' AND pg_username='twitchanalysis') THEN
        RAISE EXCEPTION 'Analyse-Peermap ist nicht ausschließlich dem Dashboarddienst zugeordnet';
    END IF;
    IF (SELECT count(*) FROM pg_hba_file_rules WHERE 'twitchanalysis'=ANY(user_name)) <> 4 OR
        NOT EXISTS (SELECT FROM pg_hba_file_rules WHERE rule_number=1 AND type='local'
            AND database=ARRAY['twitch_analytics'] AND user_name=ARRAY['twitchanalysis']
            AND auth_method='peer' AND options=ARRAY['map=twitch_analysis_writer']) OR
        NOT EXISTS (SELECT FROM pg_hba_file_rules WHERE rule_number=2 AND type='local'
            AND database=ARRAY['all'] AND user_name=ARRAY['twitchanalysis'] AND auth_method='reject') OR
        (SELECT count(*) FROM pg_hba_file_rules WHERE rule_number IN (3,4) AND type='host'
            AND database=ARRAY['all'] AND user_name=ARRAY['twitchanalysis'] AND auth_method='reject'
            AND address IN ('::','::0','0.0.0.0') AND netmask IN ('::','::0','0.0.0.0')) <> 2 THEN
        RAISE EXCEPTION 'Analyse-HBAregeln sind nicht zuerst und ausschließlich rollenbezogen';
    END IF;
    IF (SELECT count(*) FROM pg_hba_file_rules WHERE 'twitchaudit'=ANY(user_name))<>4 OR
        NOT EXISTS(SELECT FROM pg_hba_file_rules WHERE rule_number=5 AND type='local' AND database=ARRAY['twitch_analytics'] AND user_name=ARRAY['twitchaudit'] AND auth_method='peer') OR
        NOT EXISTS(SELECT FROM pg_hba_file_rules WHERE rule_number=6 AND type='local' AND database=ARRAY['all'] AND user_name=ARRAY['twitchaudit'] AND auth_method='reject') OR
        (SELECT count(*) FROM pg_hba_file_rules WHERE rule_number IN(7,8) AND type='host' AND database=ARRAY['all'] AND user_name=ARRAY['twitchaudit'] AND auth_method='reject')<>2 THEN
        RAISE EXCEPTION 'Auditverbrauch: Peersocket nicht ausschließlich rollenbezogen';
    END IF;
END
$verification$;
ROLLBACK;
SQL

[[ $(local_psql twitchdash twitch_analytics twitchanalysis -c "SELECT current_user || '|' || current_database()") == 'twitchanalysis|twitch_analytics' ]] || {
  echo "Dashboard-Peeridentität stimmt nicht." >&2; exit 1;
}
local_psql twitchdash twitch_analytics twitchanalysis -c \
  "SELECT 1 FROM public.twitch_ai_chat_sessions LIMIT 0; SELECT 1 FROM public.twitch_ai_chat_hourly LIMIT 0; SELECT 1 FROM public.twitch_ai_chat_reservations LIMIT 0;"

expect_hba_rejection() {
  local output
  if output=$("$@" 2>&1); then
    echo "Unzulässiger Analysezugang wurde angenommen." >&2
    exit 1
  fi
  if [[ "$output" != *'pg_hba.conf rejects connection'* ]]; then
    echo "Analysezugang scheiterte ohne eindeutigen HBA-Ablehnungsbeleg." >&2
    exit 1
  fi
}
expect_hba_rejection local_psql twitchdash postgres twitchanalysis -c 'SELECT 1'
listeners=$(local_psql postgres twitch_analytics postgres -c 'SHOW listen_addresses')
if [[ -z "$listeners" ]]; then
  echo "Analyse-TCPzugang: Listener deaktiviert, geladene rollenbezogene Rejectregeln separat geprüft."
else
  # Der Kontrollzugang nutzt einen Socket. Die tatsächliche TCPadresse wird
  # deshalb aus dem fest konfigurierten Listener gewählt, ohne ihn zu ändern.
  case ",$listeners," in
    *,localhost,*|*,127.0.0.1,*|*,0.0.0.0,*|*,\*,*) tcp_address=127.0.0.1 ;;
    *,::1,*|*,::,*) tcp_address=::1 ;;
    *) echo "TCPlistener benötigt einen belegten konkreten Prüfpfad; Deploy gestoppt." >&2; exit 1 ;;
  esac
  expect_hba_rejection runuser -u twitchdash -- /usr/bin/env -i /usr/bin/psql --no-psqlrc --no-password \
    "host=$tcp_address port=5432 dbname=twitch_analytics user=twitchanalysis passfile=/dev/null connect_timeout=5 sslmode=disable" \
    -v ON_ERROR_STOP=1 -At -c 'SELECT 1'
fi
echo "Liveprüfung bestanden: Reload, rollenbegrenzter Peerzugang, Ablehnung und Rechte-Metadaten."
verification_pending=0

install -m 0755 "$dest/ops/systemd/recover-twitch-llm-usage" /usr/local/bin/recover-twitch-llm-usage
install -m 0644 "$dest/ops/systemd/twitch-llm-usage-recover.toml" /etc/deadlock/twitch-llm-usage-recover.toml
install -m 0644 "$dest/ops/systemd/twitch-llm-usage-audit.toml" /etc/deadlock/twitch-llm-usage-audit.toml
install -m 0644 "$dest/ops/systemd/deadlock-twitch-llm-usage-recover.service" /etc/systemd/system/deadlock-twitch-llm-usage-recover.service
install -m 0644 "$dest/ops/systemd/deadlock-twitch-llm-usage-recover.timer" /etc/systemd/system/deadlock-twitch-llm-usage-recover.timer
systemctl daemon-reload
systemctl enable --now deadlock-twitch-llm-usage-recover.timer

for target in "${restart_targets[@]}"; do
  case "$target" in
    twitch-dashboard)
      systemctl restart deadlock-twitch-dashboard-rust.service
      ;;
    twitch-bot)
      systemctl restart deadlock-twitch-bot-rust.service
      ;;
    coaching-watch)
      systemctl restart deadlock-twitch-stream-coaching-watch.service
      ;;
    category-collector)
      systemctl restart tb-category-collector.service
      ;;
  esac
done

printf 'Twitch-Deploy fertig: %s\n' "$sha"
