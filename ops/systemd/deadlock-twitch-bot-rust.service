[Unit]
Description=Deadlock Twitch Bot (gehärtete Rust-Laufzeit)
After=network-online.target postgresql.service docker.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=twitchbot
Group=twitchbot
SupplementaryGroups=twitchmedia
WorkingDirectory=/opt/deadlock/twitch/current
ExecStartPre=/usr/local/libexec/wait-for-infisical
ExecStart=/usr/bin/bash /opt/deadlock/twitch/current/rust/scripts/run_tb_bot_service.sh
Restart=always
RestartSec=5
TimeoutStopSec=20
KillMode=mixed

LoadCredentialEncrypted=infisical-token:/etc/credstore.encrypted/deadlock-twitch-infisical.cred
Environment=HOME=/var/lib/deadlock-twitch-bot
Environment=INFISICAL_CONFIG_FILE=/etc/deadlock-twitch/infisical.conf
Environment=INFISICAL_LOADER=/usr/local/libexec/dl-infisical-env
Environment=TWITCH_RUNTIME_CONFIG_FILE=/etc/deadlock-twitch/bot.conf
Environment=TWITCH_RUNTIME_ROLE=twitch_worker
Environment=TB_DB_MIGRATE=0
Environment=TB_MCP_PORT=8892
Environment=TB_CHAT_ENABLED=1
Environment=TB_CLIP_FETCHER_ENABLED=1
Environment=VOICE_REACTION_STREAMLINK_BIN=/usr/local/libexec/deadlock-streamlink

StateDirectory=deadlock-twitch-bot
StateDirectoryMode=0700
CacheDirectory=deadlock-twitch-bot
CacheDirectoryMode=0700
LogsDirectory=deadlock-twitch-bot
LogsDirectoryMode=0700
RuntimeDirectory=deadlock-twitch-bot
RuntimeDirectoryMode=0700
BindPaths=/var/lib/deadlock-twitch-bot/data:/opt/deadlock/twitch/current/data
BindPaths=/var/log/deadlock-twitch-bot:/opt/deadlock/twitch/current/logs
BindPaths=/var/lib/deadlock-twitch-media/clips:/opt/deadlock/twitch/current/data/clips

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProcSubset=pid
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
UMask=0007
LimitCORE=0

[Install]
WantedBy=multi-user.target
