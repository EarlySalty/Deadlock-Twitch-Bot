# Atomarer, idempotenter Egress-Vertrag nur für die isolierte Downloader-UID.
# Fremde nftables-, UFW-, Tailscale- und Docker-Regeln bleiben unberührt.
add table inet deadlock_twitch_downloader
flush table inet deadlock_twitch_downloader

table inet deadlock_twitch_downloader {
    chain output {
        # Nach OUTPUT-DNAT prüfen: ein zunächst öffentliches Ziel darf nicht
        # erst hinter dieser Grenze auf Loopback/Privatnetz umgeschrieben werden.
        type filter hook output priority filter; policy accept;

        meta skuid != "twitchdownload" return

        # Öffentliches IPv6 braucht Neighbor Discovery. Nur die vier NDP-Typen
        # mit vorgeschriebenem Hop-Limit 255 dürfen Link-local/Multicast vor den
        # allgemeinen Sperren passieren; der Prozess besitzt keine Raw-Caps.
        ip6 daddr { fe80::/10, ff02::/16 } icmpv6 type { nd-router-solicit, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert } ip6 hoplimit 255 counter accept

        ip daddr { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24, 192.31.196.0/24, 192.52.193.0/24, 192.88.99.0/24, 192.168.0.0/16, 192.175.48.0/24, 198.18.0.0/15, 198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/4, 240.0.0.0/4 } counter drop comment "twitchdownload: IPv4 intern/reserviert sperren"
        ip6 daddr { ::/96, ::ffff:0:0/96, 64:ff9b::/96, 64:ff9b:1::/48, 100::/64, 100:0:0:1::/64, 2001::/23, 2001:db8::/32, 2002::/16, 2620:4f:8000::/48, 3fff::/20, 5f00::/16, fc00::/7, fec0::/10, fe80::/10, ff00::/8 } counter drop comment "twitchdownload: IPv6 intern/reserviert sperren"
        fib daddr type local counter drop comment "twitchdownload: hosteigene Adressen sperren"

        ip daddr { 1.1.1.1, 1.0.0.1 } udp dport 53 counter accept
        ip daddr { 1.1.1.1, 1.0.0.1 } tcp dport 53 counter accept
        ip6 daddr { 2606:4700:4700::1111, 2606:4700:4700::1001 } udp dport 53 counter accept
        ip6 daddr { 2606:4700:4700::1111, 2606:4700:4700::1001 } tcp dport 53 counter accept
        ip daddr 0.0.0.0/0 tcp dport { 80, 443 } counter accept
        ip6 daddr 2000::/3 tcp dport { 80, 443 } counter accept

        counter drop comment "twitchdownload: sonstigen Egress sperren"
    }
}
