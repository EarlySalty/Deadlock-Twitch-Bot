[Unit]
Description=Local health check and bounded recovery for the STT server

[Service]
Type=oneshot
ExecStart=%h/.local/bin/tb-stt-server --config %h/.config/deadlock-stt/stt.toml --recovery-check --recovery-state %S/deadlock-stt-recovery/state.json
StateDirectory=deadlock-stt-recovery
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
